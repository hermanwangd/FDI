# Source this file before running the RC6 setup.sh installer.
# The RC6 installer passes MODEL to every created/updated Swarm agent.
#
# The requested human label is "Kimi K27 coding". The exact identifier below is
# the identifier currently returned by Multica for all existing Swarm agents.
# Override only after verifying the identifier with the installed runtime.
export ENGCIM_REQUESTED_MODEL_LABEL="Kimi K27 coding"
export MODEL="${ENGCIM_SWARM_MODEL:-kimi-code/kimi-for-coding}"
