{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ENGCIM-SWARM-MODEL-SELECTION-v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "workspaceRef",
    "workspaceKnowledgeProjectRef",
    "swarmRuntimeRef",
    "requestedModelLabel",
    "effectiveModelIdentifier",
    "effectiveModelStatus",
    "exactK27VersionStatus",
    "agentCount",
    "uniformEffectiveModel",
    "verificationCommand",
    "skillPackRef",
    "agentProfilesRef",
    "skillsRef",
    "scenarioCanonicalRef",
    "scenarioRuntimeRef",
    "swarmInstructionsRef"
  ],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "workspaceRef": { "type": "string", "minLength": 1 },
    "workspaceName": { "type": "string", "minLength": 1 },
    "workspaceKnowledgeProjectRef": { "type": "string", "minLength": 1 },
    "workspaceKnowledgeProjectName": { "type": "string", "minLength": 1 },
    "swarmRuntimeRef": { "type": "string", "minLength": 1 },
    "swarmRuntimeProvider": { "type": "string", "minLength": 1 },
    "requestedModelLabel": { "type": "string", "minLength": 1 },
    "effectiveModelIdentifier": { "type": "string", "minLength": 1 },
    "effectiveModelStatus": { "enum": ["REQUESTED", "VERIFIED_FOR_EXISTING_SWARM_AGENTS", "BLOCKED"] },
    "exactK27VersionStatus": { "enum": ["CONFIRMED_BY_RUNTIME", "UNCONFIRMED_BY_MULTICA_CLI", "BLOCKED"] },
    "agentScope": { "type": "string", "minLength": 1 },
    "agentCount": { "type": "integer", "minimum": 0 },
    "uniformEffectiveModel": { "type": "boolean" },
    "verificationCommand": { "type": "string", "minLength": 1 },
    "verificationEvidence": { "type": "string", "minLength": 1 },
    "skillPackRef": { "type": "string", "minLength": 1 },
    "agentProfilesRef": { "type": "string", "minLength": 1 },
    "skillsRef": { "type": "string", "minLength": 1 },
    "scenarioCanonicalRef": { "type": "string", "minLength": 1 },
    "scenarioRuntimeRef": { "type": "string", "minLength": 1 },
    "swarmInstructionsRef": { "type": "string", "minLength": 1 }
  }
}
