              "type": [
                "string",
                "null"
              ]
            },
            "issueInspect": {
              "type": [
                "string",
                "null"
              ]
            },
            "issueRelations": {
              "type": [
                "string",
                "null"
              ]
            },
            "artifactEvidenceRead": {
              "type": [
                "string",
                "null"
              ]
            },
            "missionSubmit": {
              "type": [
                "string",
                "null"
              ]
            },
            "missionStatus": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
