    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "repoRef",
          "path"
        ],
        "properties": {
          "repoRef": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "lastVerifiedRevision": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}