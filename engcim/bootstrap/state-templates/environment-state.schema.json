          ]
        },
        "activePackageRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "activePackageDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "installRoot": {
          "type": [
            "string",
            "null"
          ]
        },
        "activationMethodRef": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastKnownGoodRevision": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastKnownGoodPackageRef": {
          "type": [
            "string",
