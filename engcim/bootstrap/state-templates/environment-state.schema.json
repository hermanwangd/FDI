    "qualifiedAt",
    "multica",
    "runtime",
    "repositories"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.2"
    },
    "qualifiedAt": {
      "type": [
        "string",
        "null"
      ]
    },
    "multica": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cliPath",
        "cliVersion",
        "cliDigest",
        "authStatus",
        "workspaceAccess",
        "workspaceRef",
        "commandDiscoveryStatus",
        "commandTemplates"
      ],
      "properties": {
        "cliPath": {
          "type": [
            "string",
            "null"
          ]
        },
        "cliVersion": {
          "type": [
            "string",
            "null"
          ]
        },
        "cliDigest": {
          "type": [
            "string",
            "null"
          ]
        },
        "authStatus": {
          "enum": [
