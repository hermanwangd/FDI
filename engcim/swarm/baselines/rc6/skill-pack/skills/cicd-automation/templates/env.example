# ============================================================
# 環境變數模板規範（env.example）
# ------------------------------------------------------------
# 用途：本檔是「所有環境變數的清單與說明」，會進版本控制；
#       真實值永遠不進 repo，由各環境的 secret store / CI 變數注入。
# 規則：
#   1. 每個變數必註明：用途、必填/選配、格式範例、各環境來源。
#   2. secret 類變數的值欄只放佔位說明（<from secret store>），
#      非 secret 才可放真實預設值。
#   3. 新增程式碼用到的變數必須同步本檔；部署前檢查清單含「env.example 與程式碼一致」。
#   4. 命名：大寫蛇形；前綴分組（DB_、AUTH_、OBS_…）。
# ============================================================

# ---- 應用基本 ----
# 用途：運行環境識別；格式：dev | staging | prod；必填；來源：CI 依目標環境注入
APP_ENV=dev

# 用途：對外服務埠；格式：1-65535；選配（預設 8080）；來源：固定預設
APP_PORT=8080

# 用途：日誌等級；格式：debug | info | warn | error；選配（預設 info）
#       prod 不許用 debug（會洩露過多細節）
LOG_LEVEL=info

# ---- 資料庫 ----
# 用途：主資料庫連線；格式：postgres://user:pass@host:5432/dbname；必填
#       【secret】值只放佔位；來源：各環境 secret store（dev 可用本地值）
DATABASE_URL=<from secret store>

# 用途：連線池上限；格式：整數；選配（預設 10）；與 DB 容量規劃對齊
DB_POOL_MAX=10

# ---- 認證 / 外部服務 ----
# 用途：<第三方服務> API 金鑰；【secret】必填（無則該整合功能停用）
#       輪替負責人：<REPLACE: owner>；輪替週期：<REPLACE: 90 天>
THIRD_PARTY_API_KEY=<from secret store>

# 用途：token 簽章金鑰；【secret】必填；prod 與非 prod 必須不同值
AUTH_SIGNING_KEY=<from secret store>

# ---- 可觀測性（S09 對接） ----
# 用途：指標/metrics 端點開關；格式：true | false；選配（預設 true）
METRICS_ENABLED=true

# 用途：OTLP 匯出端點；格式：http(s)://host:4318；prod 必填，dev 選配
OTEL_EXPORTER_ENDPOINT=

# ---- Multica（定期任務 / swarm 整合用；不需要則整段刪除） ----
# 用途：Multica API token；【secret】；crontab 觸發 S02/S09 時必填
MULTICA_TOKEN=<from secret store>

# 用途：Multica workspace；格式：UUID；使用 swarm 整合時必填
MULTICA_WORKSPACE_ID=

# ============================================================
# 環境差異矩陣（新增變數時同步更新本表）
# | 變數 | dev | staging | prod |
# |------|-----|---------|------|
# | APP_ENV | dev | staging | prod |
# | LOG_LEVEL | debug | info | info |
# | DATABASE_URL | 本地/secret store | secret store | secret store（獨立值） |
# | OTEL_EXPORTER_ENDPOINT | 可空 | 必填 | 必填 |
# ============================================================
