{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pkb001:realization-mapping:v0.4",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "authority", "capability_id", "scenario_id", "source_revision", "frozen_semantics_sha256", "direct_production_symbols", "seeds", "realization_chain", "limitations"],
  "properties": {
    "schema_version": {"const": "pkb001.realization-mapping.v0.4"},
    "authority": {"const": "PROPOSAL_ONLY"},
    "capability_id": {"$ref": "#/$defs/text"},
    "scenario_id": {"$ref": "#/$defs/text"},
    "source_revision": {"$ref": "#/$defs/revision"},
    "frozen_semantics_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "direct_production_symbols": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/direct"}},
    "seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seed"}},
    "realization_chain": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "limitations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "safe_ref": {"allOf": [{"$ref": "#/$defs/text"}, {"not": {"pattern": "(?i)(evaluator|gold[-_ ]?mapping|ground[-_ ]?truth|expected[-_ ]?mapping)"}}]},
    "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "source_path", "granularity", "qualified_symbol"],
      "properties": {
        "source_revision": {"$ref": "#/$defs/revision"},
        "source_path": {"allOf": [{"$ref": "#/$defs/text"}, {"not": {"pattern": "(^/|\\\\|(^|/)src/test(/|$)|(^|/)tests?(/|$)|Tests?\\.java$|(^|/)\\.\\.?(/|$))"}}]},
        "granularity": {"enum": ["REPOSITORY", "FILE", "TYPE", "METHOD", "TEMPLATE", "CONFIGURATION"]},
        "qualified_symbol": {"$ref": "#/$defs/text"}
      }
    },
    "direct": {
      "type": "object", "additionalProperties": false,
      "required": ["evidence_ref", "observation_ref", "production_symbol"],
      "properties": {"evidence_ref": {"$ref": "#/$defs/safe_ref"}, "observation_ref": {"$ref": "#/$defs/safe_ref"}, "production_symbol": {"$ref": "#/$defs/identity"}}
    },
    "seed": {
      "type": "object", "additionalProperties": false,
      "required": ["seed_ref", "direct_evidence_ref", "production_seed"],
      "properties": {"seed_ref": {"$ref": "#/$defs/safe_ref"}, "direct_evidence_ref": {"$ref": "#/$defs/safe_ref"}, "production_seed": {"$ref": "#/$defs/identity"}}
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": ["order", "component", "relationship_basis", "seed_ref", "trace_refs"],
      "properties": {
        "order": {"type": "integer", "minimum": 1}, "component": {"$ref": "#/$defs/identity"},
        "relationship_basis": {"enum": ["DIRECT_TEST_REFERENCE", "GRAPHIFY_INFERRED"]},
        "seed_ref": {"$ref": "#/$defs/safe_ref"},
        "trace_refs": {"type": "array", "items": {"$ref": "#/$defs/safe_ref"}, "uniqueItems": true}
      }
    }
  }
}
