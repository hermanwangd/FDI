{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fdi:validation:pkb001:task7-evaluation:v1",
  "title": "PKB-001 Task 7 bounded prototype evaluation",
  "x-fdi-authority": "VALIDATION_LOCAL_NON_GOVERNING",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "decision",
    "decision_scope",
    "pre_unblinding_validation",
    "bindings",
    "integrity",
    "metrics",
    "reviewer_agreement",
    "pending_third_review",
    "forward_expected_realization_comparison",
    "reverse_proposal_review_results",
    "thresholds",
    "human_product_team_review",
    "next_experiment_requirements",
    "proof_limits"
  ],
  "properties": {
    "schema_version": {"const": "pkb001.task7.evaluation-report.v1"},
    "report_id": {"type": "string", "minLength": 1},
    "decision": {"enum": ["GO", "REVISE", "STOP"]},
    "decision_scope": {"const": "BOUNDED_PROTOTYPE_DECISION_NO_SEMANTIC_PUBLICATION"},
    "pre_unblinding_validation": {"type": "object"},
    "bindings": {"type": "object"},
    "integrity": {"type": "object"},
    "metrics": {"type": "object"},
    "reviewer_agreement": {"type": "object"},
    "pending_third_review": {"type": "object"},
    "third_review_adjudication": {"type": "object"},
    "forward_expected_realization_comparison": {"type": "object"},
    "reverse_proposal_review_results": {"type": "array", "minItems": 5, "maxItems": 5},
    "thresholds": {"type": "object"},
    "human_product_team_review": {"type": "object"},
    "next_experiment_requirements": {"type": "array", "minItems": 4},
    "proof_limits": {"type": "array", "minItems": 1}
  }
}
