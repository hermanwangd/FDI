{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "test-behavior-evidence.schema.json",
  "title": "PKB-001 provider-neutral repository test-behavior evidence",
  "description": "Mechanical test-behavior evidence for one exact source revision (PKB-BL-009 / PKB-REVERSE-002). Expresses only extractor observations: source binding, frozen input digests, per-file and per-method test observations, and unresolved references as explicit evidence gaps. It carries no Capability names, scenario wording, Product truth, or evaluator labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provenance", "repository_id", "canonical_revision", "input_digests", "source_roots", "test_files", "incomplete", "diagnostics"],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "repository_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "canonical_revision": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "input_digests": {
      "type": "object",
      "minProperties": 1,
      "description": "Frozen per-input SHA hex digests keyed by repository-relative path. Keys are enforced canonically by the Java validator.",
      "additionalProperties": {"type": "string", "pattern": "^([0-9a-fA-F]{32}|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"}
    },
    "source_roots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source_root"}},
    "test_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_file"}},
    "incomplete": {"type": "boolean"},
    "diagnostics": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_id", "extractor_name", "extractor_version"],
      "properties": {
        "provider_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "extractor_name": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "extractor_version": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
      }
    },
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!\\s*$)(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?!.*\/$).+$"
    },
    "hex_digest": {
      "type": "string",
      "pattern": "^([0-9a-fA-F]{32}|[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "source_root": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository_relative_path"],
      "properties": {
        "kind": {"enum": ["PRODUCTION", "TEST"]},
        "repository_relative_path": {"$ref": "#/$defs/repository_path"}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_relative_path", "line", "column"],
      "properties": {
        "repository_relative_path": {"$ref": "#/$defs/repository_path"},
        "line": {"type": "integer", "minimum": 1},
        "column": {"type": "integer", "minimum": 1}
      }
    },
    "referenced_symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "declaring_type", "symbol_name", "basis"],
      "properties": {
        "kind": {"enum": ["TYPE", "METHOD", "FIELD", "CONSTRUCTOR"]},
        "declaring_type": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "symbol_name": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "basis": {"enum": ["SAME_PACKAGE_SOURCE_ROOT", "IMPORTED_SOURCE_ROOT", "PRODUCTION_RECEIVER_SOURCE_ROOT"]}
      }
    },
    "behavior_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "observed_expression", "location", "referenced_symbol"],
      "properties": {
        "kind": {"enum": ["FIXTURE", "ACTION", "ASSERTION"]},
        "observed_expression": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "location": {"$ref": "#/$defs/location"},
        "referenced_symbol": {"anyOf": [{"$ref": "#/$defs/referenced_symbol"}, {"type": "null"}]}
      }
    },
    "unresolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference_text", "location", "kind"],
      "properties": {
        "reference_text": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "location": {"$ref": "#/$defs/location"},
        "kind": {"enum": ["EXTERNAL_DEPENDENCY_NOT_RESOLVED", "AMBIGUOUS", "MISSING_SOURCE", "SYNTACTIC_ONLY"]}
      }
    },
    "test_method": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method_name", "declaration_location", "fixtures", "actions", "assertions", "unresolved_references"],
      "properties": {
        "method_name": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "declaration_location": {"$ref": "#/$defs/location"},
        "fixtures": {"type": "array", "items": {"$ref": "#/$defs/behavior_observation"}},
        "actions": {"type": "array", "items": {"$ref": "#/$defs/behavior_observation"}},
        "assertions": {"type": "array", "items": {"$ref": "#/$defs/behavior_observation"}},
        "unresolved_references": {"type": "array", "items": {"$ref": "#/$defs/unresolved_reference"}}
      }
    },
    "test_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_relative_path", "input_digest", "test_class_name", "nested_container", "test_methods", "unresolved_references"],
      "properties": {
        "repository_relative_path": {"$ref": "#/$defs/repository_path"},
        "input_digest": {"$ref": "#/$defs/hex_digest"},
        "test_class_name": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "nested_container": {"type": "boolean"},
        "test_methods": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_method"}},
        "unresolved_references": {"type": "array", "items": {"$ref": "#/$defs/unresolved_reference"}}
      }
    }
  }
}
