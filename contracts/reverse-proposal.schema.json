{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reverse-proposal.schema.json",
  "title": "PKB-001 provider-neutral reverse proposal package",
  "description": "Sealed proposal-only output of one deterministic reverse-proposal generation run (PKB-BL-009 / PKB-REVERSE-002). Capability and behavior scenario hypotheses cite contributing evidence exactly; single-channel observations remain explicit evidence gaps. Every proposal is PROPOSAL_ONLY, UNREVIEWED, and blocked from semantic publication: reverse results are hypotheses, not Product truth, and only the Human Reviewer can accept, edit, or reject them. Confidence is a deterministic 0-10000 scale-4 ranking hint, explicitly not authority. Mirrors com.featuredeliveryintelligence.fdi.reverse.proposal.ReverseProposalPackage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_id", "canonical_revision", "capabilities", "scenarios", "evidence_gaps"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "repository_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
    "canonical_revision": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
    "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability"}},
    "scenarios": {"type": "array", "items": {"$ref": "#/$defs/scenario"}},
    "evidence_gaps": {"type": "array", "items": {"$ref": "#/$defs/evidence_gap"}}
  },
  "$defs": {
    "sha256_hex": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "channel_id": {"enum": ["STRUCTURAL", "TEST_BEHAVIOR", "DELIVERY_HISTORY"]},
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "observation_ref", "evidence_digest"],
      "properties": {
        "channel": {"$ref": "#/$defs/channel_id"},
        "observation_ref": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "evidence_digest": {"$ref": "#/$defs/sha256_hex"}
      }
    },
    "confidence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Confidence on a 0-10000 scale (4 decimal digits of the 0-1 range). A deterministic ranking hint, never authority."
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "citations", "source_revision", "contributing_evidence_digests", "inference_rationale", "limitations", "confidence", "authority", "semantic_publication_allowed"],
      "properties": {
        "id": {"type": "string", "pattern": "^HYP-CAPABILITY-[0-9A-Z][0-9A-Z._-]*$"},
        "title": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "source_revision": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "contributing_evidence_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256_hex"}},
        "inference_rationale": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "authority": {"enum": ["PROPOSAL_ONLY"]},
        "semantic_publication_allowed": {"const": false}
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capability_id", "title", "given", "when", "then", "citations", "source_revision", "contributing_evidence_digests", "inference_rationale", "limitations", "confidence", "scenario_status", "authority", "semantic_publication_allowed"],
      "properties": {
        "id": {"type": "string", "pattern": "^HYP-SCENARIO-[0-9A-Z][0-9A-Z._-]*$"},
        "capability_id": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "title": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "given": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "when": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "then": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "citations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/citation"}},
        "source_revision": {"type": "string", "pattern": "^([0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"},
        "contributing_evidence_digests": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sha256_hex"}},
        "inference_rationale": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "limitations": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "scenario_status": {"enum": ["UNREVIEWED"]},
        "authority": {"enum": ["PROPOSAL_ONLY"]},
        "semantic_publication_allowed": {"const": false}
      }
    },
    "evidence_gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channel", "observation_ref", "evidence_digest", "reason"],
      "properties": {
        "channel": {"$ref": "#/$defs/channel_id"},
        "observation_ref": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"},
        "evidence_digest": {"$ref": "#/$defs/sha256_hex"},
        "reason": {"type": "string", "minLength": 1, "pattern": ".*\\S.*"}
      }
    }
  }
}
