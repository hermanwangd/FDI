{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FDI Graphify Binding Evidence Record v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_id",
    "product_or_scenario_id",
    "snapshot_ref",
    "snapshot_binding_attestation",
    "captured_at",
    "result",
    "limitations"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "evidence_id": {"type": "string", "pattern": "^gbe:[0-9a-f]{24}$"},
    "product_or_scenario_id": {"type": "string", "minLength": 1},
    "snapshot_ref": {"$ref": "#/$defs/snapshotRef"},
    "snapshot_binding_attestation": {"$ref": "#/$defs/attestation"},
    "captured_at": {"type": "string", "minLength": 1},
    "result": {"const": "EXACTLY_BOUND"},
    "limitations": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "gitRevision": {
      "type": "string",
      "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64})$"
    },
    "sourceSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "revision": {"$ref": "#/$defs/gitRevision"}
      }
    },
    "snapshotRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_id", "provider", "adapter_version", "source_snapshots", "created_at"],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "GRAPHIFY"},
            "version": {"type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
          }
        },
        "adapter_version": {"type": "string", "minLength": 1},
        "source_snapshots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/sourceSnapshot"}
        },
        "created_at": {"type": "string", "minLength": 1}
      }
    },
    "providerRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "ref"],
      "properties": {
        "scope_id": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1}
      }
    },
    "repositoryBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "indexed_revision", "queryable", "head_revision"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "indexed_revision": {"$ref": "#/$defs/gitRevision"},
        "queryable": {"const": true},
        "head_revision": {"type": ["string", "null"]}
      }
    },
    "providerRuntime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_version", "wire_version", "adapter_version", "compatibility"],
      "properties": {
        "runtime_version": {"type": "string", "minLength": 1},
        "wire_version": {"type": "string", "minLength": 1},
        "adapter_version": {"type": "string", "minLength": 1},
        "compatibility": {"const": "VERIFIED"}
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_id",
        "binding_state",
        "provider_route",
        "freshness",
        "repositories",
        "attestation_id",
        "provider_runtime"
      ],
      "properties": {
        "snapshot_id": {"type": "string", "minLength": 1},
        "binding_state": {"const": "VERIFIED"},
        "provider_route": {"$ref": "#/$defs/providerRoute"},
        "freshness": {"enum": ["LIVE_CURRENT", "FROZEN_INDEXED"]},
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryBinding"}
        },
        "attestation_id": {"type": "string", "pattern": "^sba:[0-9a-f]{24}$"},
        "provider_runtime": {"$ref": "#/$defs/providerRuntime"}
      }
    }
  }
}
